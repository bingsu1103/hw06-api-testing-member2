diff --git a/backend/member2-password.cjs b/backend/member2-password.cjs
new file mode 100644
index 0000000..5a4924c
--- /dev/null
+++ b/backend/member2-password.cjs
@@ -0,0 +1,20 @@
+const { randomBytes, scryptSync, timingSafeEqual } = require("node:crypto");
+
+function strongPassword(value) {
+  return typeof value === "string" && value.length >= 8 && value.length <= 256 &&
+    /[A-Z]/.test(value) && /[a-z]/.test(value) && /[0-9]/.test(value) && /[@$!%*?&]/.test(value);
+}
+
+function hashPassword(value) {
+  const salt = randomBytes(16).toString("hex");
+  return salt + ":" + scryptSync(value, salt, 32).toString("hex");
+}
+
+function verifyPassword(value, stored) {
+  if (typeof value !== "string" || value.length > 256 || typeof stored !== "string") return false;
+  const [salt, key] = stored.split(":");
+  if (!/^[a-f0-9]{32}$/.test(salt) || !/^[a-f0-9]{64}$/.test(key || "")) return false;
+  return timingSafeEqual(Buffer.from(key, "hex"), scryptSync(value, salt, 32));
+}
+
+module.exports = { strongPassword, hashPassword, verifyPassword };
